#: src/mainwindow.cpp
msgid "Getting required packages"
msgstr "جارٍ الحصول على الحزم المطلوبة"

#: src/mainwindow.cpp
msgid "Checking dependencies"
msgstr "جارٍ التحقق من الاعتماديات"

#: src/mainwindow.cpp
msgid "Checking package"
msgstr "جارٍ التحقق من الحزمة"

#: src/mainwindow.cpp
msgid "Unpacking package"
msgstr "جارٍ فك الحزمة"

#: src/mainwindow.cpp
msgid "Configuring package"
msgstr "جارٍ إعداد الحزمة"

#: src/mainwindow.cpp
msgid "Installing package"
msgstr "جارٍ تثبيت الحزمة"

#: src/mainwindow.cpp
msgid "Finishing installation"
msgstr "جارٍ إكمال التثبيت"

#: src/mainwindow.cpp
msgid "Waiting for administrator authorization"
msgstr "بانتظار مصادقة المسؤول"

#: src/mainwindow.cpp
msgid "Working with the system package service"
msgstr "جارٍ استخدام خدمة حزم النظام"

#: src/mainwindow.cpp
msgid "Administrator authorization was not completed."
msgstr "لم تكتمل مصادقة المسؤول."

#: src/mainwindow.cpp
msgid "There is not enough free disk space to install this package."
msgstr "لا تتوفر مساحة كافية على القرص لتثبيت هذه الحزمة."

#: src/mainwindow.cpp
msgid "This package conflicts with software already on the system."
msgstr "تتعارض هذه الحزمة مع برامج مثبتة بالفعل على النظام."

#: src/mainwindow.cpp
msgid "Some required software could not be installed."
msgstr "تعذر تثبيت بعض البرامج المطلوبة."

#: src/mainwindow.cpp
msgid ""
"The required software could not be downloaded from the configured "
"repositories."
msgstr "تعذر تنزيل البرامج المطلوبة من المستودعات المُعدّة."

#: src/mainwindow.cpp
msgid "This package is already installed."
msgstr "هذه الحزمة مثبتة بالفعل."

#: src/mainwindow.cpp
msgid "The system package service could not verify this package."
msgstr "تعذر على خدمة حزم النظام التحقق من هذه الحزمة."

#: src/mainwindow.cpp
msgid ""
"The package could not be installed. No success was reported by the system "
"package service."
msgstr "تعذر تثبيت الحزمة. لم تؤكد خدمة حزم النظام نجاح العملية."

#: src/mainwindow.cpp lingmo-package-installer.desktop
msgid "Lingmo Package Installer"
msgstr "مثبّت حزم Lingmo"

#: src/mainwindow.cpp
msgid "Application menu"
msgstr "قائمة التطبيقات"

#: src/mainwindow.cpp
msgid "Lingmo OS"
msgstr "Lingmo OS"

#: src/mainwindow.cpp
msgid "Drop the app here to install"
msgstr "أفلت أيقونة الحزمة هنا لتثبيتها"

#: src/mainwindow.cpp
msgid "View details"
msgstr "عرض التفاصيل"

#: src/mainwindow.cpp
msgid "The package manager will check dependencies and request authorization."
msgstr "ستتحقق خدمة حزم النظام من الاعتماديات وستطلب الإذن عند الحاجة."

#: src/mainwindow.cpp
msgid "Open a Debian package to get started"
msgstr "افتح حزمة Debian للبدء"

#: src/mainwindow.cpp
msgid "Double-click or drop a .deb here, or launch with a package path."
msgstr "انقر نقرًا مزدوجًا على ملف ‎.deb‎ أو أفلتْه هنا، أو شغّل التطبيق مع تحديد مسار الحزمة."

#: src/mainwindow.cpp
msgid "Installing"
msgstr "جارٍ التثبيت"

#: src/mainwindow.cpp
msgid "Cancel"
msgstr "إلغاء"

#: src/mainwindow.cpp
msgid "Could not continue"
msgstr "تعذر المتابعة"

#: src/mainwindow.cpp
msgid "Installation complete"
msgstr "اكتمل التثبيت"

#: src/mainwindow.cpp
msgid "The package was installed successfully."
msgstr "تم تثبيت الحزمة بنجاح."

#: src/mainwindow.cpp
msgid "Done"
msgstr "تم"

#: src/mainwindow.cpp
msgid "No package selected"
msgstr "لم تُحدد حزمة"

#: src/mainwindow.cpp
msgid "Package details"
msgstr "تفاصيل الحزمة"

#: src/mainwindow.cpp
msgid "Version "
msgstr "الإصدار "

#: src/mainwindow.cpp
msgid "No description is provided."
msgstr "لا يتوفر وصف للحزمة."

#: src/mainwindow.cpp
msgid "Local package · source not verified"
msgstr "حزمة محلية · المصدر غير متحقق منه"

#: src/mainwindow.cpp
msgid "Source: "
msgstr "المصدر: "

#: src/mainwindow.cpp
msgid "File size: "
msgstr "حجم الملف: "

#: src/mainwindow.cpp
msgid "Unavailable"
msgstr "غير متاح"

#: src/mainwindow.cpp
#, python-brace-format
msgid "Package {current} of {total}"
msgstr "الحزمة {current} من أصل {total}"

#: src/mainwindow.cpp
msgid "Installation was interrupted."
msgstr "تم إيقاف التثبيت."

#: src/mainwindow.cpp
msgid "This file is missing or cannot be read."
msgstr "الملف غير موجود أو يتعذر قراءته."

#: src/mainwindow.cpp
msgid "Reading package information"
msgstr "جارٍ قراءة معلومات الحزمة"

#: src/mainwindow.cpp
msgid "This does not appear to be a readable Debian package."
msgstr "يبدو أن هذا ليس ملف حزمة Debian قابلًا للقراءة."

#: src/mainwindow.cpp
msgid "The package information is incomplete or damaged."
msgstr "معلومات الحزمة غير مكتملة أو تالفة."

#: src/mainwindow.cpp
msgid "The Debian package tools are not available."
msgstr "أدوات حزم Debian غير متاحة."

#: src/mainwindow.cpp
msgid "The system architecture could not be checked."
msgstr "تعذر التحقق من بنية النظام."

#: src/mainwindow.cpp
msgid "This package is for a different system architecture."
msgstr "هذه الحزمة مخصصة لبنية نظام مختلفة."

#: src/mainwindow.cpp
msgid "Package architecture: "
msgstr "بنية الحزمة: "

#: src/mainwindow.cpp
msgid "System architecture: "
msgstr "بنية النظام: "

#: src/mainwindow.cpp
msgid "The current package status could not be checked."
msgstr "تعذر التحقق من الحالة الحالية للحزمة."

#: src/mainwindow.cpp
msgid "The installed package version could not be checked."
msgstr "تعذر التحقق من إصدار الحزمة المثبتة."

#: src/mainwindow.cpp
msgid "Installed version: "
msgstr "الإصدار المثبت: "

#: src/mainwindow.cpp
msgid "A newer version of this package is already installed."
msgstr "إصدار أحدث من هذه الحزمة مثبت بالفعل."

#: src/mainwindow.cpp
msgid "Install this package?"
msgstr "هل تريد تثبيت هذه الحزمة؟"

#: src/mainwindow.cpp
#, python-brace-format
msgid ""
"Install {name} version {version}? The system package service will resolve "
"dependencies and ask before making system changes. A local package may not "
"have a verifiable repository signature."
msgstr "هل تريد تثبيت {name} بالإصدار {version}؟ ستحل خدمة حزم النظام الاعتماديات وستطلب الإذن قبل إجراء تغييرات على النظام. قد لا تتضمن الحزمة المحلية توقيع مستودع يمكن التحقق منه."

#: src/mainwindow.cpp
msgid "Install"
msgstr "تثبيت"

#: src/mainwindow.cpp
msgid "The system package service could not be started."
msgstr "تعذر بدء خدمة حزم النظام."

#: src/mainwindow.cpp
msgid "Make sure PackageKit is running and accessible over the system bus."
msgstr "تأكد من تشغيل PackageKit وإمكانية الوصول إليه عبر ناقل النظام."

#: src/mainwindow.cpp
msgid "Cancelling installation"
msgstr "جارٍ إلغاء التثبيت"

#: src/mainwindow.cpp
msgid "Application"
msgstr "التطبيق"

#: src/mainwindow.cpp
msgid "Quit"
msgstr "إنهاء"

#: src/mainwindow.cpp
msgid "Help"
msgstr "مساعدة"

#: src/mainwindow.cpp
msgid "About Lingmo Package Installer"
msgstr "حول مثبّت حزم Lingmo"

#: src/mainwindow.cpp
msgid "Package information"
msgstr "معلومات الحزمة"

#: src/mainwindow.cpp
msgid "Name: "
msgstr "الاسم: "

#: src/mainwindow.cpp
msgid "Version: "
msgstr "الإصدار: "

#: src/mainwindow.cpp
msgid "Architecture: "
msgstr "البنية: "

#: src/mainwindow.cpp
msgid "Maintainer: "
msgstr "المسؤول عن الصيانة: "

#: src/mainwindow.cpp
msgid "Not provided"
msgstr "غير متوفر"

#: src/mainwindow.cpp
msgid "Local package; repository signature not available"
msgstr "حزمة محلية؛ لا يتوفر توقيع مستودع قابل للتحقق"

#: src/mainwindow.cpp
msgid "Package file size: "
msgstr "حجم ملف الحزمة: "

#: src/mainwindow.cpp
msgid "Installed size: "
msgstr "الحجم بعد التثبيت: "

#: src/mainwindow.cpp
msgid "Pre-dependencies: "
msgstr "الاعتماديات السابقة: "

#: src/mainwindow.cpp
msgid "Dependencies: "
msgstr "الاعتماديات: "

#: src/mainwindow.cpp
msgid "Conflicts: "
msgstr "التعارضات: "

#: src/mainwindow.cpp
msgid "Installation details"
msgstr "تفاصيل التثبيت"

#: src/mainwindow.cpp
msgid "Install local Debian software packages with the Lingmo desktop."
msgstr "ثبّت حزم برامج Debian المحلية باستخدام سطح مكتب Lingmo."

#: lingmo-package-installer.desktop
msgid "Install Debian software packages"
msgstr "تثبيت حزم برامج Debian"

#: lingmo-package-installer.desktop
msgid "Debian;Package;Install;"
msgstr "Debian;حزمة;تثبيت;"
