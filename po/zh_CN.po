#: src/mainwindow.cpp
msgid "Getting required packages"
msgstr "正在获取所需软件包"

#: src/mainwindow.cpp
msgid "Checking dependencies"
msgstr "正在检查依赖项"

#: src/mainwindow.cpp
msgid "Checking package"
msgstr "正在检查软件包"

#: src/mainwindow.cpp
msgid "Unpacking package"
msgstr "正在解包"

#: src/mainwindow.cpp
msgid "Configuring package"
msgstr "正在配置软件包"

#: src/mainwindow.cpp
msgid "Installing package"
msgstr "正在安装软件包"

#: src/mainwindow.cpp
msgid "Finishing installation"
msgstr "正在完成安装"

#: src/mainwindow.cpp
msgid "Waiting for administrator authorization"
msgstr "正在等待管理员授权"

#: src/mainwindow.cpp
msgid "Working with the system package service"
msgstr "正在使用系统软件包服务"

#: src/mainwindow.cpp
msgid "Administrator authorization was not completed."
msgstr "未完成管理员授权。"

#: src/mainwindow.cpp
msgid "There is not enough free disk space to install this package."
msgstr "磁盘空间不足，无法安装此软件包。"

#: src/mainwindow.cpp
msgid "This package conflicts with software already on the system."
msgstr "此软件包与系统中已有的软件冲突。"

#: src/mainwindow.cpp
msgid "Some required software could not be installed."
msgstr "部分必需软件无法安装。"

#: src/mainwindow.cpp
msgid "The required software could not be downloaded from the configured repositories."
msgstr "无法从已配置的软件仓库下载所需软件。"

#: src/mainwindow.cpp
msgid "This package is already installed."
msgstr "此软件包已安装。"

#: src/mainwindow.cpp
msgid "The system package service could not verify this package."
msgstr "系统软件包服务无法验证此软件包。"

#: src/mainwindow.cpp
msgid "The package could not be installed. No success was reported by the system package service."
msgstr "无法安装此软件包。系统软件包服务未确认安装成功。"

#: src/mainwindow.cpp lingmo-package-installer.desktop
msgid "Lingmo Package Installer"
msgstr "Lingmo 软件包安装器"

#: src/mainwindow.cpp
msgid "Application menu"
msgstr "应用菜单"

#: src/mainwindow.cpp
msgid "Lingmo OS"
msgstr "Lingmo OS"

#: src/mainwindow.cpp
msgid "Drop the app here to install"
msgstr "将软件包图标拖到此处安装"

#: src/mainwindow.cpp
msgid "View details"
msgstr "查看详情"

#: src/mainwindow.cpp
msgid "The package manager will check dependencies and request authorization."
msgstr "系统软件包服务会检查依赖项，并在需要时请求管理员授权。"

#: src/mainwindow.cpp
msgid "Open a Debian package to get started"
msgstr "打开 Debian 软件包以开始使用"

#: src/mainwindow.cpp
msgid "Double-click or drop a .deb here, or launch with a package path."
msgstr "双击或将 .deb 文件拖到此处，也可从命令行传入软件包路径。"

#: src/mainwindow.cpp
msgid "Installing"
msgstr "正在安装"

#: src/mainwindow.cpp
msgid "Cancel"
msgstr "取消"

#: src/mainwindow.cpp
msgid "Could not continue"
msgstr "无法继续"

#: src/mainwindow.cpp
msgid "Installation complete"
msgstr "安装完成"

#: src/mainwindow.cpp
msgid "The package was installed successfully."
msgstr "软件包已成功安装。"

#: src/mainwindow.cpp
msgid "Done"
msgstr "完成"

#: src/mainwindow.cpp
msgid "No package selected"
msgstr "未选择软件包"

#: src/mainwindow.cpp
msgid "Package details"
msgstr "软件包详情"

#: src/mainwindow.cpp
msgid "Version "
msgstr "版本 "

#: src/mainwindow.cpp
msgid "No description is provided."
msgstr "未提供软件包描述。"

#: src/mainwindow.cpp
msgid "Local package · source not verified"
msgstr "本地软件包 · 来源未经验证"

#: src/mainwindow.cpp
msgid "Source: "
msgstr "来源："

#: src/mainwindow.cpp
msgid "File size: "
msgstr "文件大小："

#: src/mainwindow.cpp
msgid "Unavailable"
msgstr "不可用"

#: src/mainwindow.cpp
#, python-brace-format
msgid "Package {current} of {total}"
msgstr "第 {current} 个，共 {total} 个软件包"

#: src/mainwindow.cpp
msgid "Installation was interrupted."
msgstr "安装已中断。"

#: src/mainwindow.cpp
msgid "This file is missing or cannot be read."
msgstr "文件不存在或无法读取。"

#: src/mainwindow.cpp
msgid "Reading package information"
msgstr "正在读取软件包信息"

#: src/mainwindow.cpp
msgid "This does not appear to be a readable Debian package."
msgstr "这似乎不是可读取的 Debian 软件包。"

#: src/mainwindow.cpp
msgid "The package information is incomplete or damaged."
msgstr "软件包信息不完整或已损坏。"

#: src/mainwindow.cpp
msgid "The Debian package tools are not available."
msgstr "Debian 软件包处理工具不可用。"

#: src/mainwindow.cpp
msgid "The system architecture could not be checked."
msgstr "无法检查系统架构。"

#: src/mainwindow.cpp
msgid "This package is for a different system architecture."
msgstr "此软件包不适用于当前系统架构。"

#: src/mainwindow.cpp
msgid "Package architecture: "
msgstr "软件包架构："

#: src/mainwindow.cpp
msgid "System architecture: "
msgstr "系统架构："

#: src/mainwindow.cpp
msgid "The current package status could not be checked."
msgstr "无法查询此软件包的安装状态。"

#: src/mainwindow.cpp
msgid "The installed package version could not be checked."
msgstr "无法检查已安装的软件包版本。"

#: src/mainwindow.cpp
msgid "Installed version: "
msgstr "已安装版本："

#: src/mainwindow.cpp
msgid "A newer version of this package is already installed."
msgstr "系统中已安装此软件包的更新版本。"

#: src/mainwindow.cpp
msgid "Install this package?"
msgstr "是否安装此软件包？"

#: src/mainwindow.cpp
#, python-brace-format
msgid "Install {name} version {version}? The system package service will resolve dependencies and ask before making system changes. A local package may not have a verifiable repository signature."
msgstr "要安装 {name} {version} 吗？系统软件包服务将处理依赖项，并在更改系统前请求授权。本地软件包可能没有可验证的软件仓库签名。"

#: src/mainwindow.cpp
msgid "Install"
msgstr "安装"

#: src/mainwindow.cpp
msgid "The system package service could not be started."
msgstr "无法启动系统软件包服务。"

#: src/mainwindow.cpp
msgid "Make sure PackageKit is running and accessible over the system bus."
msgstr "请确认 PackageKit 已启动，且可通过系统总线访问。"

#: src/mainwindow.cpp
msgid "Cancelling installation"
msgstr "正在取消安装"

#: src/mainwindow.cpp
msgid "Application"
msgstr "应用"

#: src/mainwindow.cpp
msgid "Quit"
msgstr "退出"

#: src/mainwindow.cpp
msgid "Help"
msgstr "帮助"

#: src/mainwindow.cpp
msgid "About Lingmo Package Installer"
msgstr "关于 Lingmo 软件包安装器"

#: src/mainwindow.cpp
msgid "Package information"
msgstr "软件包信息"

#: src/mainwindow.cpp
msgid "Name: "
msgstr "名称："

#: src/mainwindow.cpp
msgid "Version: "
msgstr "版本："

#: src/mainwindow.cpp
msgid "Architecture: "
msgstr "架构："

#: src/mainwindow.cpp
msgid "Maintainer: "
msgstr "维护者："

#: src/mainwindow.cpp
msgid "Not provided"
msgstr "未提供"

#: src/mainwindow.cpp
msgid "Local package; repository signature not available"
msgstr "本地软件包；没有可验证的软件仓库签名"

#: src/mainwindow.cpp
msgid "Package file size: "
msgstr "软件包文件大小："

#: src/mainwindow.cpp
msgid "Installed size: "
msgstr "安装后大小："

#: src/mainwindow.cpp
msgid "Pre-dependencies: "
msgstr "预依赖："

#: src/mainwindow.cpp
msgid "Dependencies: "
msgstr "依赖："

#: src/mainwindow.cpp
msgid "Conflicts: "
msgstr "冲突："

#: src/mainwindow.cpp
msgid "Installation details"
msgstr "安装详情"

#: src/mainwindow.cpp
msgid "Install local Debian software packages with the Lingmo desktop."
msgstr "使用 Lingmo 桌面安装本地 Debian 软件包。"

#: lingmo-package-installer.desktop
msgid "Install Debian software packages"
msgstr "安装 Debian 软件包"

#: lingmo-package-installer.desktop
msgid "Debian;Package;Install;"
msgstr "Debian;软件包;安装;"

#~ msgid "Install…"
#~ msgstr "安装…"

#~ msgid "Make sure PackageKit and its command-line tools are installed."
#~ msgstr "请确认已安装 PackageKit 及其命令行工具。"
