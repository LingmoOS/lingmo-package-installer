#: src/mainwindow.cpp
msgid "Getting required packages"
msgstr "Obtendo os pacotes necessários"

#: src/mainwindow.cpp
msgid "Checking dependencies"
msgstr "Verificando as dependências"

#: src/mainwindow.cpp
msgid "Checking package"
msgstr "Verificando o pacote"

#: src/mainwindow.cpp
msgid "Unpacking package"
msgstr "Descompactando o pacote"

#: src/mainwindow.cpp
msgid "Configuring package"
msgstr "Configurando o pacote"

#: src/mainwindow.cpp
msgid "Installing package"
msgstr "Instalando o pacote"

#: src/mainwindow.cpp
msgid "Finishing installation"
msgstr "Concluindo a instalação"

#: src/mainwindow.cpp
msgid "Waiting for administrator authorization"
msgstr "Aguardando autorização do administrador"

#: src/mainwindow.cpp
msgid "Working with the system package service"
msgstr "Usando o serviço de pacotes do sistema"

#: src/mainwindow.cpp
msgid "Administrator authorization was not completed."
msgstr "A autorização do administrador não foi concluída."

#: src/mainwindow.cpp
msgid "There is not enough free disk space to install this package."
msgstr "Não há espaço livre em disco suficiente para instalar este pacote."

#: src/mainwindow.cpp
msgid "This package conflicts with software already on the system."
msgstr "Este pacote conflita com softwares já instalados no sistema."

#: src/mainwindow.cpp
msgid "Some required software could not be installed."
msgstr "Não foi possível instalar alguns softwares necessários."

#: src/mainwindow.cpp
msgid ""
"The required software could not be downloaded from the configured "
"repositories."
msgstr "Não foi possível baixar os softwares necessários dos repositórios configurados."

#: src/mainwindow.cpp
msgid "This package is already installed."
msgstr "Este pacote já está instalado."

#: src/mainwindow.cpp
msgid "The system package service could not verify this package."
msgstr "O serviço de pacotes do sistema não conseguiu verificar este pacote."

#: src/mainwindow.cpp
msgid ""
"The package could not be installed. No success was reported by the system "
"package service."
msgstr "Não foi possível instalar o pacote. O serviço de pacotes do sistema não confirmou o sucesso."

#: src/mainwindow.cpp lingmo-package-installer.desktop
msgid "Lingmo Package Installer"
msgstr "Instalador de pacotes Lingmo"

#: src/mainwindow.cpp
msgid "Application menu"
msgstr "Menu de aplicativos"

#: src/mainwindow.cpp
msgid "Lingmo OS"
msgstr "Lingmo OS"

#: src/mainwindow.cpp
msgid "Drop the app here to install"
msgstr "Solte o ícone do pacote aqui para instalá-lo"

#: src/mainwindow.cpp
msgid "View details"
msgstr "Ver detalhes"

#: src/mainwindow.cpp
msgid "The package manager will check dependencies and request authorization."
msgstr "O serviço de pacotes do sistema verificará as dependências e solicitará autorização, se necessário."

#: src/mainwindow.cpp
msgid "Open a Debian package to get started"
msgstr "Abra um pacote Debian para começar"

#: src/mainwindow.cpp
msgid "Double-click or drop a .deb here, or launch with a package path."
msgstr "Clique duas vezes em um arquivo .deb ou solte-o aqui. Você também pode iniciar o aplicativo informando o caminho do pacote."

#: src/mainwindow.cpp
msgid "Installing"
msgstr "Instalando"

#: src/mainwindow.cpp
msgid "Cancel"
msgstr "Cancelar"

#: src/mainwindow.cpp
msgid "Could not continue"
msgstr "Não foi possível continuar"

#: src/mainwindow.cpp
msgid "Installation complete"
msgstr "Instalação concluída"

#: src/mainwindow.cpp
msgid "The package was installed successfully."
msgstr "O pacote foi instalado com sucesso."

#: src/mainwindow.cpp
msgid "Done"
msgstr "Concluído"

#: src/mainwindow.cpp
msgid "No package selected"
msgstr "Nenhum pacote selecionado"

#: src/mainwindow.cpp
msgid "Package details"
msgstr "Detalhes do pacote"

#: src/mainwindow.cpp
msgid "Version "
msgstr "Versão "

#: src/mainwindow.cpp
msgid "No description is provided."
msgstr "Nenhuma descrição do pacote foi fornecida."

#: src/mainwindow.cpp
msgid "Local package · source not verified"
msgstr "Pacote local · origem não verificada"

#: src/mainwindow.cpp
msgid "Source: "
msgstr "Origem: "

#: src/mainwindow.cpp
msgid "File size: "
msgstr "Tamanho do arquivo: "

#: src/mainwindow.cpp
msgid "Unavailable"
msgstr "Indisponível"

#: src/mainwindow.cpp
#, python-brace-format
msgid "Package {current} of {total}"
msgstr "Pacote {current} de {total}"

#: src/mainwindow.cpp
msgid "Installation was interrupted."
msgstr "A instalação foi interrompida."

#: src/mainwindow.cpp
msgid "This file is missing or cannot be read."
msgstr "O arquivo não existe ou não pode ser lido."

#: src/mainwindow.cpp
msgid "Reading package information"
msgstr "Lendo as informações do pacote"

#: src/mainwindow.cpp
msgid "This does not appear to be a readable Debian package."
msgstr "Este arquivo não parece ser um pacote Debian legível."

#: src/mainwindow.cpp
msgid "The package information is incomplete or damaged."
msgstr "As informações do pacote estão incompletas ou danificadas."

#: src/mainwindow.cpp
msgid "The Debian package tools are not available."
msgstr "As ferramentas de pacotes Debian não estão disponíveis."

#: src/mainwindow.cpp
msgid "The system architecture could not be checked."
msgstr "Não foi possível verificar a arquitetura do sistema."

#: src/mainwindow.cpp
msgid "This package is for a different system architecture."
msgstr "Este pacote é destinado a uma arquitetura de sistema diferente."

#: src/mainwindow.cpp
msgid "Package architecture: "
msgstr "Arquitetura do pacote: "

#: src/mainwindow.cpp
msgid "System architecture: "
msgstr "Arquitetura do sistema: "

#: src/mainwindow.cpp
msgid "The current package status could not be checked."
msgstr "Não foi possível verificar o estado atual do pacote."

#: src/mainwindow.cpp
msgid "The installed package version could not be checked."
msgstr "Não foi possível verificar a versão do pacote instalado."

#: src/mainwindow.cpp
msgid "Installed version: "
msgstr "Versão instalada: "

#: src/mainwindow.cpp
msgid "A newer version of this package is already installed."
msgstr "Uma versão mais recente deste pacote já está instalada."

#: src/mainwindow.cpp
msgid "Install this package?"
msgstr "Instalar este pacote?"

#: src/mainwindow.cpp
#, python-brace-format
msgid ""
"Install {name} version {version}? The system package service will resolve "
"dependencies and ask before making system changes. A local package may not "
"have a verifiable repository signature."
msgstr "Instalar {name} versão {version}? O serviço de pacotes do sistema resolverá as dependências e solicitará autorização antes de fazer alterações no sistema. Um pacote local pode não ter uma assinatura de repositório verificável."

#: src/mainwindow.cpp
msgid "Install"
msgstr "Instalar"

#: src/mainwindow.cpp
msgid "The system package service could not be started."
msgstr "Não foi possível iniciar o serviço de pacotes do sistema."

#: src/mainwindow.cpp
msgid "Make sure PackageKit is running and accessible over the system bus."
msgstr "Verifique se o PackageKit está em execução e acessível pelo barramento do sistema."

#: src/mainwindow.cpp
msgid "Cancelling installation"
msgstr "Cancelando a instalação"

#: src/mainwindow.cpp
msgid "Application"
msgstr "Aplicativo"

#: src/mainwindow.cpp
msgid "Quit"
msgstr "Sair"

#: src/mainwindow.cpp
msgid "Help"
msgstr "Ajuda"

#: src/mainwindow.cpp
msgid "About Lingmo Package Installer"
msgstr "Sobre o instalador de pacotes Lingmo"

#: src/mainwindow.cpp
msgid "Package information"
msgstr "Informações do pacote"

#: src/mainwindow.cpp
msgid "Name: "
msgstr "Nome: "

#: src/mainwindow.cpp
msgid "Version: "
msgstr "Versão: "

#: src/mainwindow.cpp
msgid "Architecture: "
msgstr "Arquitetura: "

#: src/mainwindow.cpp
msgid "Maintainer: "
msgstr "Mantenedor: "

#: src/mainwindow.cpp
msgid "Not provided"
msgstr "Não informado"

#: src/mainwindow.cpp
msgid "Local package; repository signature not available"
msgstr "Pacote local; assinatura do repositório não disponível para verificação"

#: src/mainwindow.cpp
msgid "Package file size: "
msgstr "Tamanho do arquivo do pacote: "

#: src/mainwindow.cpp
msgid "Installed size: "
msgstr "Tamanho instalado: "

#: src/mainwindow.cpp
msgid "Pre-dependencies: "
msgstr "Pré-dependências: "

#: src/mainwindow.cpp
msgid "Dependencies: "
msgstr "Dependências: "

#: src/mainwindow.cpp
msgid "Conflicts: "
msgstr "Conflitos: "

#: src/mainwindow.cpp
msgid "Installation details"
msgstr "Detalhes da instalação"

#: src/mainwindow.cpp
msgid "Install local Debian software packages with the Lingmo desktop."
msgstr "Instale pacotes de software Debian locais com a área de trabalho Lingmo."

#: lingmo-package-installer.desktop
msgid "Install Debian software packages"
msgstr "Instalar pacotes de software Debian"

#: lingmo-package-installer.desktop
msgid "Debian;Package;Install;"
msgstr "Debian;Pacote;Instalar;"
