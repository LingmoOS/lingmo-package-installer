#: src/mainwindow.cpp
msgid "Getting required packages"
msgstr "必要なパッケージを取得中"

#: src/mainwindow.cpp
msgid "Checking dependencies"
msgstr "依存関係を確認中"

#: src/mainwindow.cpp
msgid "Checking package"
msgstr "パッケージを確認中"

#: src/mainwindow.cpp
msgid "Unpacking package"
msgstr "パッケージを展開中"

#: src/mainwindow.cpp
msgid "Configuring package"
msgstr "パッケージを設定中"

#: src/mainwindow.cpp
msgid "Installing package"
msgstr "パッケージをインストール中"

#: src/mainwindow.cpp
msgid "Finishing installation"
msgstr "インストールを完了中"

#: src/mainwindow.cpp
msgid "Waiting for administrator authorization"
msgstr "管理者の認証を待っています"

#: src/mainwindow.cpp
msgid "Working with the system package service"
msgstr "システムのパッケージサービスを使用中"

#: src/mainwindow.cpp
msgid "Administrator authorization was not completed."
msgstr "管理者の認証が完了しませんでした。"

#: src/mainwindow.cpp
msgid "There is not enough free disk space to install this package."
msgstr "このパッケージをインストールするための空きディスク容量が不足しています。"

#: src/mainwindow.cpp
msgid "This package conflicts with software already on the system."
msgstr "このパッケージはシステムにインストール済みのソフトウェアと競合します。"

#: src/mainwindow.cpp
msgid "Some required software could not be installed."
msgstr "必要なソフトウェアの一部をインストールできませんでした。"

#: src/mainwindow.cpp
msgid ""
"The required software could not be downloaded from the configured "
"repositories."
msgstr "設定済みのリポジトリから必要なソフトウェアをダウンロードできませんでした。"

#: src/mainwindow.cpp
msgid "This package is already installed."
msgstr "このパッケージはすでにインストールされています。"

#: src/mainwindow.cpp
msgid "The system package service could not verify this package."
msgstr "システムのパッケージサービスはこのパッケージを検証できませんでした。"

#: src/mainwindow.cpp
msgid ""
"The package could not be installed. No success was reported by the system "
"package service."
msgstr "このパッケージをインストールできませんでした。システムのパッケージサービスから成功が報告されませんでした。"

#: src/mainwindow.cpp lingmo-package-installer.desktop
msgid "Lingmo Package Installer"
msgstr "Lingmo パッケージインストーラー"

#: src/mainwindow.cpp
msgid "Application menu"
msgstr "アプリケーションメニュー"

#: src/mainwindow.cpp
msgid "Lingmo OS"
msgstr "Lingmo OS"

#: src/mainwindow.cpp
msgid "Drop the app here to install"
msgstr "インストールするには、ここにパッケージアイコンをドロップ"

#: src/mainwindow.cpp
msgid "View details"
msgstr "詳細を表示"

#: src/mainwindow.cpp
msgid "The package manager will check dependencies and request authorization."
msgstr "パッケージ管理サービスが依存関係を確認し、認証を求めます。"

#: src/mainwindow.cpp
msgid "Open a Debian package to get started"
msgstr "Debian パッケージを開いて開始"

#: src/mainwindow.cpp
msgid "Double-click or drop a .deb here, or launch with a package path."
msgstr ".deb をダブルクリックするかここにドロップするか、パッケージのパスを指定して起動してください。"

#: src/mainwindow.cpp
msgid "Installing"
msgstr "インストール中"

#: src/mainwindow.cpp
msgid "Cancel"
msgstr "キャンセル"

#: src/mainwindow.cpp
msgid "Could not continue"
msgstr "続行できません"

#: src/mainwindow.cpp
msgid "Installation complete"
msgstr "インストール完了"

#: src/mainwindow.cpp
msgid "The package was installed successfully."
msgstr "パッケージが正常にインストールされました。"

#: src/mainwindow.cpp
msgid "Done"
msgstr "完了"

#: src/mainwindow.cpp
msgid "No package selected"
msgstr "パッケージが選択されていません"

#: src/mainwindow.cpp
msgid "Package details"
msgstr "パッケージの詳細"

#: src/mainwindow.cpp
msgid "Version "
msgstr "バージョン "

#: src/mainwindow.cpp
msgid "No description is provided."
msgstr "説明はありません。"

#: src/mainwindow.cpp
msgid "Local package · source not verified"
msgstr "ローカルパッケージ · ソース未確認"

#: src/mainwindow.cpp
msgid "Source: "
msgstr "ソース："

#: src/mainwindow.cpp
msgid "File size: "
msgstr "ファイルサイズ："

#: src/mainwindow.cpp
msgid "Unavailable"
msgstr "利用不可"

#: src/mainwindow.cpp
#, python-brace-format
msgid "Package {current} of {total}"
msgstr "全 {total} 個中 {current} 個目のパッケージ"

#: src/mainwindow.cpp
msgid "Installation was interrupted."
msgstr "インストールが中断されました。"

#: src/mainwindow.cpp
msgid "This file is missing or cannot be read."
msgstr "ファイルが存在しないか、読み取れません。"

#: src/mainwindow.cpp
msgid "Reading package information"
msgstr "パッケージ情報を読み込み中"

#: src/mainwindow.cpp
msgid "This does not appear to be a readable Debian package."
msgstr "読み取り可能な Debian パッケージではないようです。"

#: src/mainwindow.cpp
msgid "The package information is incomplete or damaged."
msgstr "パッケージ情報が不完全または破損しています。"

#: src/mainwindow.cpp
msgid "The Debian package tools are not available."
msgstr "Debian パッケージツールを利用できません。"

#: src/mainwindow.cpp
msgid "The system architecture could not be checked."
msgstr "システムのアーキテクチャを確認できませんでした。"

#: src/mainwindow.cpp
msgid "This package is for a different system architecture."
msgstr "このパッケージは別のシステムアーキテクチャ向けです。"

#: src/mainwindow.cpp
msgid "Package architecture: "
msgstr "パッケージのアーキテクチャ："

#: src/mainwindow.cpp
msgid "System architecture: "
msgstr "システムのアーキテクチャ："

#: src/mainwindow.cpp
msgid "The current package status could not be checked."
msgstr "現在のパッケージ状態を確認できませんでした。"

#: src/mainwindow.cpp
msgid "The installed package version could not be checked."
msgstr "インストール済みパッケージのバージョンを確認できませんでした。"

#: src/mainwindow.cpp
msgid "Installed version: "
msgstr "インストール済みバージョン："

#: src/mainwindow.cpp
msgid "A newer version of this package is already installed."
msgstr "このパッケージの新しいバージョンがすでにインストールされています。"

#: src/mainwindow.cpp
msgid "Install this package?"
msgstr "このパッケージをインストールしますか？"

#: src/mainwindow.cpp
#, python-brace-format
msgid ""
"Install {name} version {version}? The system package service will resolve "
"dependencies and ask before making system changes. A local package may not "
"have a verifiable repository signature."
msgstr "{name} バージョン {version} をインストールしますか？システムのパッケージサービスが依存関係を解決し、システムを変更する前に確認を求めます。ローカルパッケージには検証可能なリポジトリ署名がない場合があります。"

#: src/mainwindow.cpp
msgid "Install"
msgstr "インストール"

#: src/mainwindow.cpp
msgid "The system package service could not be started."
msgstr "システムのパッケージサービスを起動できませんでした。"

#: src/mainwindow.cpp
msgid "Make sure PackageKit is running and accessible over the system bus."
msgstr "PackageKit が起動しており、システムバスからアクセスできることを確認してください。"

#: src/mainwindow.cpp
msgid "Cancelling installation"
msgstr "インストールをキャンセル中"

#: src/mainwindow.cpp
msgid "Application"
msgstr "アプリケーション"

#: src/mainwindow.cpp
msgid "Quit"
msgstr "終了"

#: src/mainwindow.cpp
msgid "Help"
msgstr "ヘルプ"

#: src/mainwindow.cpp
msgid "About Lingmo Package Installer"
msgstr "Lingmo パッケージインストーラーについて"

#: src/mainwindow.cpp
msgid "Package information"
msgstr "パッケージ情報"

#: src/mainwindow.cpp
msgid "Name: "
msgstr "名前："

#: src/mainwindow.cpp
msgid "Version: "
msgstr "バージョン："

#: src/mainwindow.cpp
msgid "Architecture: "
msgstr "アーキテクチャ："

#: src/mainwindow.cpp
msgid "Maintainer: "
msgstr "メンテナー："

#: src/mainwindow.cpp
msgid "Not provided"
msgstr "未提供"

#: src/mainwindow.cpp
msgid "Local package; repository signature not available"
msgstr "ローカルパッケージ；リポジトリ署名を利用できません"

#: src/mainwindow.cpp
msgid "Package file size: "
msgstr "パッケージファイルサイズ："

#: src/mainwindow.cpp
msgid "Installed size: "
msgstr "インストール後のサイズ："

#: src/mainwindow.cpp
msgid "Pre-dependencies: "
msgstr "事前依存関係："

#: src/mainwindow.cpp
msgid "Dependencies: "
msgstr "依存関係："

#: src/mainwindow.cpp
msgid "Conflicts: "
msgstr "競合："

#: src/mainwindow.cpp
msgid "Installation details"
msgstr "インストールの詳細"

#: src/mainwindow.cpp
msgid "Install local Debian software packages with the Lingmo desktop."
msgstr "Lingmo デスクトップでローカルの Debian ソフトウェアパッケージをインストールします。"

#: lingmo-package-installer.desktop
msgid "Install Debian software packages"
msgstr "Debian ソフトウェアパッケージをインストール"

#: lingmo-package-installer.desktop
msgid "Debian;Package;Install;"
msgstr "Debian;パッケージ;インストール;"
