msgid "Maintainer: "
msgstr "Mainteneur : "

#: src/mainwindow.cpp
msgid "Not provided"
msgstr "Non indiqué"

#: src/mainwindow.cpp
msgid "Local package; repository signature not available"
msgstr "Paquet local ; aucune signature de dépôt vérifiable"

#: src/mainwindow.cpp
msgid "Package file size: "
msgstr "Taille du fichier du paquet : "

#: src/mainwindow.cpp
msgid "Installed size: "
msgstr "Taille après installation : "

